{
  "schemaVersion": 1,
  "id": "betteradminshop",
  "version": "${version}",
  "name": "Create: Better Admin Shop",
  "description": "Adds a functional shop block to Create Mod with item display, purchase orders, stock management, and Depot integration.",
  "authors": [
    "Me!"
  ],
  "contact": {
    "sources": "https://github.com/Fabricators-of-Create/create-fabric-addon-template"
  },
  "license": "CC0",
  "icon": "assets/betteradminshop/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.betteradminshop.BetterAdminShop"
    ],
    "client": [
      "com.example.betteradminshop.BetterAdminShopClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "create": "*",
    "minecraft": "${minecraft_version}"
  }
}
